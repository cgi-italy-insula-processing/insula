{
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
        "generateName": "workflow-pvc-",
        "labels": {
            "platform/jobid": "theJobId"
        },
        "namespace": "namespace"
    },
    "spec": {
        "accessModes": [
            "ReadWriteOnce"
        ],
        "resources": {
            "requests": {
                "storage": "50Mi"
            }
        }
    }
}
