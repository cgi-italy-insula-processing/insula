{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Workflow",
  "metadata": {
    "labels": {
      "platform/jobid": "theJobId",
      "platform/workflow-type": "job",
      "platform/intjobid": "30"
    },
    "generateName": "workflow-"
  },
  "spec": {
    "entrypoint": "workflowTemplate",
    "volumeClaimTemplates": [
      {
        "metadata": {
          "name": "workerhome"
        },
        "spec": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "resources": {
            "requests": {
              "storage": "10240Mi"
            }
          }
        }
      }
    ],
    "imagePullSecrets": [
      {
        "name": "externalRegistryImagePullSecretName"
      },
      {
        "name": "internalPlatformRegistryImagePullSecretName"
      }
    ],
    "templates": [
      {
        "name": "workflowTemplate",
        "steps": [
          [
            {
              "name": "input",
              "template": "input",
              "arguments": {
                "parameters": [
                  {
                    "name": "input-inputs",
                    "value": "{\"ParamC\":{\"type\":\"OTHER\",\"values\":[\"ParamCValue1\"],\"subsetting\":null},\"ParamB\":{\"type\":\"URL\",\"values\":[\"ParamBValue1\"],\"subsetting\":null},\"ParamA\":{\"type\":\"OTHER\",\"values\":[\"ParamAValue1\"],\"subsetting\":null},\"params\":{\"type\":\"OTHER\",\"values\":[\"paramsValue1\",\"paramsValue2\"],\"subsetting\":null}}"
                  },
                  {
                    "name": "input-basepath",
                    "value": "/home/worker/workDir"
                  },
                  {
                    "name": "input-jobId",
                    "value": "theJobId"
                  }
                ]
              }
            }
          ],
          [
            {
              "name": "processing",
              "template": "processing"
            }
          ],
          [
            {
              "name": "output",
              "template": "output",
              "arguments": {
                "parameters": [
                  {
                    "name": "output-basepath",
                    "value": "/home/worker/workDir/outDir"
                  },
                  {
                    "name": "output-jobId",
                    "value": "theJobId"
                  },
                  {
                    "name": "output-internal-jobId",
                    "value": "30"
                  },
                  {
                    "name": "output-outputs",
                    "value": "{\"ParamD\":\"/home/worker/workDir/.\"}"
                  }
                ]
              }
            }
          ]
        ]
      },
      {
        "name": "input",
        "container": {
          "image": "inputDownloaderImageName",
          "command": [],
          "args": [],
          "volumeMounts": [
            {
              "name": "workerhome",
              "mountPath": "/home/worker/workDir"
            }
          ],
          "env": [
            {
              "name": "BASE_PATH",
              "value": "{{inputs.parameters.input-basepath}}"
            },
            {
              "name": "INPUTS",
              "value": "{{inputs.parameters.input-inputs}}"
            },
            {
              "name": "JOB_ID",
              "value": "{{inputs.parameters.input-jobId}}"
            },
            {
              "name": "JOB_OWNER",
              "value": "theJobOwner"
            },
            {
              "name": "SPRING_APPLICATION_NAME",
              "value": "inputdownloader"
            },
            {
              "name": "TEMPFOLDER",
              "value": "{{inputs.parameters.input-basepath}}/tmp"
            }
          ]
        },
        "metadata": {
          "annotations": {},
          "labels": {
            "platform/jobid": "theJobId",
            "platform/workflow-step": "input-download",
            "platform/intjobid": "30"
          }
        },
        "inputs": {
          "parameters": [
            {
              "name": "input-basepath"
            },
            {
              "name": "input-inputs"
            },
            {
              "name": "input-jobId"
            }
          ]
        }
      },
      {
        "name": "processing",
        "container": {
          "image": "internalPlatformRegistryPrefix/test:1.1",
          "command": [
            "dockerCommand"
          ],
          "workingDir": "/home/worker/workDir",
          "args": [
            "arg1",
            "arg2",
            "/home/worker/workDir/inDir/ParamB",
            "ParamAValue1",
            "--prefix paramsValue1",
            "--prefix paramsValue2"
          ],
          "volumeMounts": [
            {
              "name": "workerhome",
              "mountPath": "/home/worker/workDir"
            }
          ],
          "env": [
            {
              "name": "KEY1",
              "value": "VALUE1"
            },
            {
              "name": "envKey",
              "value": "envValue"
            }
          ]
        },
        "metadata": {
          "annotations": {},
          "labels": {
            "platform/jobid": "theJobId",
            "platform/workflow-step": "processing",
            "platform/intjobid": "30"
          }
        }
      },
      {
        "name": "output",
        "container": {
          "image": "outputUploaderImageName",
          "command": [],
          "args": [],
          "volumeMounts": [
            {
              "name": "workerhome",
              "mountPath": "/home/worker/workDir"
            }
          ],
          "env": [
            {
              "name": "BASE_PATH",
              "value": "{{inputs.parameters.output-basepath}}"
            },
            {
              "name": "JOB_ID",
              "value": "{{inputs.parameters.output-jobId}}"
            },
            {
              "name": "SPRING_APPLICATION_NAME",
              "value": "outputuploader"
            },
            {
              "name": "OUTPUTS",
              "value": "{{inputs.parameters.output-outputs}}"
            }
          ]
        },
        "metadata": {
          "annotations": {},
          "labels": {
            "platform/jobid": "theJobId",
            "platform/workflow-step": "output-upload"
          }
        },
        "inputs": {
          "parameters": [
            {
              "name": "output-basepath"
            },
            {
              "name": "output-jobId"
            },
            {
              "name": "output-internal-jobId"
            },
            {
              "name": "output-outputs"
            }
          ]
        }
      }
    ],
    "volumes": []
  }
}